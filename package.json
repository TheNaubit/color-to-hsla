{
  "name": "@nauverse/color-to-hsla",
  "description": "A tiny, dependency-free TypeScript library to convert any CSS color (hex, rgb, hsl, named colors, modern CSS syntax) to HSLA.",
  "author": {
    "name": "Albert Adler | @albertadler",
    "url": "https://albertadler.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/TheNaubit/color-to-hsla#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheNaubit/color-to-hsla.git"
  },
  "bugs": {
    "url": "https://github.com/TheNaubit/color-to-hsla/issues"
  },
  "keywords": [
    "hex",
    "color",
    "hsl",
    "rgb",
    "rgb-color",
    "rgba",
    "hsla",
    "hsla-colors",
    "hsla-color",
    "rgb-to-hsla",
    "rgba-to-hsla",
    "hex-to-hsla",
    "color-to-hsla",
    "css-to-hsla"
  ],
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/color-to-hsla.umd.cjs",
  "module": "./dist/color-to-hsla.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/color-to-hsla.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/color-to-hsla.umd.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-commits-filter": "6.0.1",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.14.0 || >=24.10.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "warn"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
